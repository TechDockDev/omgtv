generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthSubjectType {
  ADMIN
  CUSTOMER
  GUEST
}

enum GuestLifecycleStatus {
  ACTIVE
  MIGRATED
}

enum AuthProvider {
  FIREBASE
  DLT
}

enum OtpEvent {
  SEND_REQUESTED
  DLT_API_SUCCESS
  DLT_API_FAILED
  VERIFY_ATTEMPT
  VERIFY_SUCCESS
  VERIFY_FAILED
  EXPIRED
  RATE_LIMITED
}

model AuthSubject {
  id              String          @id @default(uuid())
  type            AuthSubjectType
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  admin           AdminCredential?
  customer        CustomerIdentity?
  guest           GuestIdentity?
  migratedGuests  GuestIdentity[] @relation("GuestMigratedSubject")
  sessions        Session[]
}

model AdminCredential {
  subject            AuthSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId          String       @id
  email              String       @unique
  passwordHash       String
  isActive           Boolean      @default(true)
  passwordUpdatedAt  DateTime     @updatedAt
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model CustomerIdentity {
  subject      AuthSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId    String        @id
  firebaseUid  String?       @unique
  phoneNumber  String?       @unique @map("phoneNumber")
  authProvider AuthProvider  @default(FIREBASE) @map("authProvider")
  customerId   String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?
  otpLogs      OtpLog[]

  // First-touch ad attribution — set once at creation, never overwritten.
  attributionSource String?
  campaignId         String?
  adsetId            String?
  adId               String?
  contentId          String? // series/episode/reel the deep link pointed to
}

model GuestIdentity {
  subject             AuthSubject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId           String             @id
  guestId             String
  deviceId            String
  guestProfileId      String             @unique
  status              GuestLifecycleStatus @default(ACTIVE)
  migratedToSubject   AuthSubject?       @relation("GuestMigratedSubject", fields: [migratedToSubjectId], references: [id])
  migratedToSubjectId String?
  migratedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // First-touch ad attribution — set once at creation, never overwritten.
  attributionSource String?
  campaignId         String?
  adsetId            String?
  adId               String?
  contentId          String? // series/episode/reel the deep link pointed to

  @@unique([guestId, deviceId])
}

// Append-only log of every ad-driven app open — both deferred (fresh install)
// and direct (already installed, re-engagement) deep links. Unlike the
// first-touch fields above, this captures repeat touches on existing users too.
model AttributionEvent {
  id         String   @id @default(uuid())
  guestId    String?
  customerId String?
  eventType  String
  source     String
  campaignId String?
  adsetId    String?
  adId       String?
  contentId  String? // series/episode/reel the deep link pointed to
  occurredAt DateTime @default(now())

  @@index([customerId])
  @@index([guestId])
  @@index([occurredAt])
}

model Session {
  id               String      @id @default(uuid())
  subject          AuthSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId        String
  refreshTokenHash String      @unique
  deviceId         String?
  userAgent        String?
  createdAt        DateTime    @default(now())
  expiresAt        DateTime

  @@index([subjectId])
}

model OtpLog {
  id           String           @id @default(uuid())
  phone        String
  event        OtpEvent
  subjectId    String?
  customer     CustomerIdentity? @relation(fields: [subjectId], references: [subjectId])
  dltRequestId String?
  errorCode    String?
  errorMessage String?
  attemptCount Int               @default(1)
  ip           String?
  deviceId     String?
  appVersion   String?
  createdAt    DateTime          @default(now())

  @@index([phone, createdAt])
  @@index([event, createdAt])
  @@index([subjectId])
}

model GeneralSetting {
  id              Int      @id @default(1)
  supportEmail    String?
  helpCenterEmail String?
  contactPhone    String?
  whatsappNumber  String?
  twitterHandle   String?
  facebookUrl     String?
  instagramHandle String?
  companyName     String?
  businessAddress String?
  updatedByAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
